{
  "name": "ping_tunnel_edge",
  "version": "0.0.5",
  "description": "Edge client for QUIC tunnel",
  "main": "index.js",
  "types": "index.d.ts",
  "keywords": [
    "quic",
    "tunnel",
    "edge",
    "network",
    "native",
    "napi"
  ],
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": ""
  },
  "napi": {
    "binaryName": "ping_tunnel"
  },
  "scripts": {
    "build": "napi build --platform --release --features napi -o ./build --js false && mv ./build/ping_tunnel.darwin-arm64.node ./nodejs/edge.node",
    "build:debug": "napi build --platform --features napi",
    "build:all": "echo 'Please build for all platforms manually or use CI/CD'",
    "artifacts": "napi artifacts",
    "version": "napi version",
    "edge": "RUST_LOG=debug cargo run --bin edge  -- 127.0.0.1:4433 127 127.0.0.1:11100",
    "supernode": "RUST_LOG=debug cargo run --bin supernode -- 0.0.0.0:4433 0.0.0.0:4432 ./cert/cert.pem ./cert/key.pem"
  },
  "dependencies": {
    "@napi-rs/cli": "^3.5.0"
  },
  "engines": {
    "node": ">= 10"
  },
  "files": [
    "build/"
  ]
}
